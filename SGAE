async function runVerify() {
  const results = [];
  const certOk = !!(CERT_HASHES.anchor && CERT_HASHES.identity && CERT_HASHES.record);
  results.push({ n:'Certificate SHA-256', ok:certOk, d: certOk ? 'Anchor: ' + CERT_HASHES.anchor.substring(0,16) + '…' : 'Missing' });
  const masterOk = CERTIFICATE_IDENTITY.reference_code === 'CMC-REF-2026-MSI-003';
  results.push({ n:'Master Reference', ok:masterOk, d: masterOk ? CERTIFICATE_IDENTITY.reference_code : 'Mismatch' });
  const cryptoOk = Object.keys(STATE.crypto).length > 0;
  results.push({ n:'Market Data', ok:cryptoOk, d: `${Object.keys(STATE.crypto).length} coins` });
  const chainsOk = Object.keys(STATE.chains).length >= 0;
  results.push({ n:'Blockchain Networks', ok:chainsOk, d:'Ethereum, Polygon, Base' });
  results.push({ n:'Modules Registered', ok:true, d:`${MODULES.length} modules` });
  results.push({ n:'Datasets Available', ok:true, d:`${DATASETS.length} files · ${DATASETS.reduce((s,d)=>s+d.count,0).toLocaleString()} records` });
  results.push({ n:'Network Status', ok:navigator.onLine, d: navigator.onLine ? 'Online' : 'Offline' });
  results.push({ n:'Browser Support', ok:true, d:'Web Crypto API available' });

  const ok = results.filter(r => r.ok).length;
  const pct = Math.round((ok / results.length) * 100);
  const vp = document.getElementById('verify-pct');
  if (vp) { vp.textContent = pct + '%'; vp.style.color = pct === 100 ? 'var(--green)' : pct >= 70 ? 'var(--gold)' : 'var(--red)'; }
  const vl = document.getElementById('verify-label');
  if (vl) vl.textContent = pct === 100 ? '✅ ALL SYSTEMS OPERATIONAL' : pct >= 70 ? '⚠️ MOSTLY OPERATIONAL' : '❌ ISSUES DETECTED';
  const vr = document.getElementById('verify-results');
  if (vr) vr.innerHTML = results.map(r => `
    <div style="padding:.5rem 0;border-bottom:1px dashed var(--border);display:flex;justify-content:space-between;gap:.5rem;font-size:.72rem;">
      <span style="color:${r.ok?'var(--green)':'var(--gold)'};font-weight:800;">${r.ok?'✅':'⚠️'} ${r.n}</span>
      <span style="color:var(--dim);font-size:.62rem;text-align:right;">${r.d}</span>
    </div>`).join('');
  const vb = document.getElementById('verify-badge');
  if (vb) vb.textContent = `${ok}/${results.length} passed`;
  sysLog(`VERIFY: ${ok}/${results.length} checks passed (${pct}%)`, pct >= 70 ? 'ok' : 'warn');
  showToast('Verified', `${pct}% — ${ok}/${results.length}`, pct >= 70 ? 'success' : 'warning');
}


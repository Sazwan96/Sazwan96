function copyText(txt) {
  if (!txt) return;
  navigator.clipboard.writeText(txt).then(() => showToast('Copied', 'Disalin', 'success')).catch(() => showToast('Gagal', 'Clipboard blocked', 'warning'));
}

async function sha256Hex(input) {
  const buf = new TextEncoder().encode(input);
  const h = await crypto.subtle.digest('SHA-256', buf);
  return Array.from(new Uint8Array(h)).map(b => b.toString(16).padStart(2,'0')).join('');
}

function sysLog(msg, type='info') {
  const el = document.getElementById('sys-log'); if (!el) return;
  const time = new Date().toLocaleTimeString('ms-MY', {hour12:false});
  const cls = { ok:'l-ok', warn:'l-warn', err:'l-err', info:'l-info' }[type] || 'l-info';
  const line = document.createElement('div');
  line.innerHTML = `<span class="l-time">[${time}]</span> <span class="${cls}">${msg}</span>`;
  el.appendChild(line); el.scrollTop = el.scrollHeight;
  if (el.children.length > 100) el.removeChild(el.firstChild);
}

/* ─── CERTIFICATE ─────────────────────────────────────────────────────── */
async function renderCert() {
  const I = CERTIFICATE_IDENTITY;
  CERT_HASHES.identity = await sha256Hex([I.full_name, I.date_of_birth, I.reference_code, I.serial_number, I.handle, I.origin].join('|'));
  CERT_HASHES.record = await sha256Hex(JSON.stringify(I, Object.keys(I).sort()));
  CERT_HASHES.anchor = await sha256Hex(CERT_HASHES.identity + ':' + CERT_HASHES.record + ':' + I.verification_sig);

  const initials = I.full_name.split(' ').filter(w => /^[A-Za-z]/.test(w)).map(w => w[0]).filter((v,i,a) => a.indexOf(v)===i).slice(0,3).join('').toUpperCase();
  const set = (id,v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
  set('cert-initials', initials);
  set('cert-name', I.full_name);
  set('cert-f-name', I.full_name);
  set('cert-f-dob', I.date_of_birth);
  set('cert-f-ref', I.reference_code);
  set('cert-f-serial', I.serial_number);
  set('cert-f-handle', I.handle);
  set('cert-f-origin', I.origin);
  set('hash-id', CERT_HASHES.identity);
  set('hash-rec', CERT_HASHES.record);
  set('hash-anchor', CERT_HASHES.anchor);

  const wt = document.getElementById('welcome-text');
  if (wt) wt.textContent = `👋 Goodbye, ${I.full_name}`;
}

async function verifyCert() {
  const I = CERTIFICATE_IDENTITY;
  const id = await sha256Hex([I.full_name, I.date_of_birth, I.reference_code, I.serial_number, I.handle, I.origin].join('|'));
  const rec = await sha256Hex(JSON.stringify(I, Object.keys(I).sort()));
  const anc = await sha256Hex(id + ':' + rec + ':' + I.verification_sig);
  const ok = id === CERT_HASHES.identity && rec === CERT_HASHES.record && anc === CERT_HASHES.anchor;
  showToast(ok ? '✅ Valid' : '❌ Breach', ok ? 'SHA-256 intact' : 'Hash mismatch', ok ? 'success' : 'danger');
  sysLog(ok ? 'CERTIFICATE VERIFIED: SHA-256 chain intact' : 'CERTIFICATE ERROR: hash mismatch', ok ? 'ok' : 'err');
}

function copyCertJSON() {
  const p = { certificate:{...CERTIFICATE_IDENTITY, hashes:CERT_HASHES}, generated_at:new Date().toISOString() };
  copyText(JSON.stringify(p, null, 2));
}


function showToast(title, msg, type='success') {
  const c = document.getElementById('toast');
  const t = document.createElement('div');
  t.className = 'toast' + (type !== 'success' ? ' ' + type : '');
  t.innerHTML = `<div class="icon">${type === 'success' ? '✅' : type === 'warning' ? '⚠️' : '🔔'}</div><div class="body"><div class="title">${title}</div><div>${msg}</div></div><button class="close" onclick="this.parentElement.remove()">×</button>`;
  c.appendChild(t);
  setTimeout(() => t.remove(), 5000);

            for (let i = 0; i < byteArray.length; i++) {
                const hex = byteArray[i].toString(16);
                const paddedHex = ('00' + hex).slice(-2);
                hexParts.push(paddedHex);
            }
            return hexParts.join('');
        }

        // Main hash generation function
        async function generateHashes() {
            const textInput = document.getElementById('textInput').value;
            const fileInput = document.getElementById('fileInput');
            
            let content = textInput;
            let isFile = false;

            // If file is selected, read its content
            if (fileInput.files.length > 0 && !textInput) {
                const file = fileInput.files[0];
                content = await readFileAsText(file);
                isFile = true;
                
                // Display file information
                document.getElementById('fileInfo').style.display = 'block';
                document.getElementById('fileDetails').innerHTML = `
                    <p><strong>Filename:</strong> ${file.name}</p>
                    <p><strong>Size:</strong> ${formatFileSize(file.size)}</p>
                    <p><strong>Type:</strong> ${file.type || 'Unknown'}</p>
                    <p><strong>Last Modified:</strong> ${new Date(file.lastModified).toLocaleString()}</p>
                `;
            }

            if (!content) {
                alert('Please enter text or select a file');
                return;
            }

            // Generate hashes based on selected algorithms
            const algorithms = [
                { id: 'md5Check', result: 'md5Result', hash: 'md5Hash', func: async (c) => generateMD5(c) },
                { id: 'sha1Check', result: 'sha1Result', hash: 'sha1Hash', func: async (c) => {
                    const buffer = await generateHash(c, 'SHA-1');
                    return arrayBufferToHex(buffer);
                }},
                { id: 'sha256Check', result: 'sha256Result', hash: 'sha256Hash', func: async (c) => {
                    const buffer = await generateHash(c, 'SHA-256');
                    return arrayBufferToHex(buffer);
                }},
                { id: 'sha512Check', result: 'sha512Result', hash: 'sha512Hash', func: async (c) => {
                    const buffer = await generateHash(c, 'SHA-512');
                    return arrayBufferToHex(buffer);
                }}
            ];

            for (const algo of algorithms) {
                const checkbox = document.getElementById(algo.id);
                const resultDiv = document.getElementById(algo.result);
                const hashDiv = document.getElementById(algo.hash);

                if (checkbox.checked) {
                    try {
                        const hash = await algo.func(content);
                        hashDiv.textContent = hash;
                        resultDiv.style.display = 'block';
                    } catch (error) {
                        hashDiv.textContent = 'Error generating hash';
                        resultDiv.style.display = 'block';
                        console.error(`Error generating ${algo.id}:`, error);
                    }
                } else {
                    resultDiv.style.display = 'none';
                }
            }
        }

        // File handling functions
        function readFileAsText(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = e => resolve(e.target.result);
                reader.onerror = reject;
                reader.readAsText(file);
            });
        }

        function handleFileSelect() {
            document.getElementById('textInput').value = '';
            generateHashes();
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        function copyHash(elementId) {
            const hashElement = document.getElementById(elementId);
            const textArea = document.createElement('textarea');
            textArea.value = hashElement.textContent;
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
            
            // Visual feedback
            const button = event.target;
            const originalText = button.textContent;
            button.textContent = 'Copied!';
            button.style.background = '#17a2b8';
            setTimeout(() => {
                button.textContent = originalText;
                button.style.background = '';
            }, 2000);
        }

        // Initialize with example
        window.onload = function() {
            document.getElementById('textInput').value = 'Hello, World!';
            generateHashes();
        };
    </script>
</body>
</html>
